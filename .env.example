# Copy to .env. Never commit real credentials.
# Shared by the ReAct decision model in Agent and planning/image/review in Creative MCP.
ZHIPU_API_KEY=
IMAGE_PROVIDER=cogview

# Optional paid reference-conditioned image provider. No automatic paid fallback.
ARK_API_KEY=
ALLOW_PAID_IMAGE_API=false

# 3D reconstruction and artifacts remain on this computer.
GRAPHICS_DATA_DIR=.graphics
WEBSCAN_URL=http://127.0.0.1:8787
WEBSCAN_REPO=../web-scan
CREATIVE_MCP_URL=http://127.0.0.1:8766
WEBSCAN_MCP_URL=http://127.0.0.1:8767
PORT=8080
